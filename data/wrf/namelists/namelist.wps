&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2019-08-07_00:00:00','2019-08-07_00:00:00',
 end_date   = '2019-08-10_00:00:00','2019-08-10_00:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
 opt_output_from_geogrid_path = './',
/
&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   4,
 i_parent_start    =   1,  76,
 j_parent_start    =   1, 146,
 e_we              = 391, 333,
 e_sn              = 311, 225,
 geog_data_res     = 'default','default',
 dx = 12000,
 dy = 12000,
 map_proj = 'mercator',
 ref_lat   = 21.0,
 ref_lon   = 122.5,
 truelat1  = 21.0,
 stand_lon = 122.5,
 geog_data_path = '/scratch/$USER/WPS_GEOG_extract/WPS_GEOG/',
 opt_geogrid_tbl_path = '/scratch/$USER/tcheat/wrf/tables/',
/
&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/
&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
 opt_output_from_metgrid_path = './',
 opt_metgrid_tbl_path = '/scratch/$USER/tcheat/wrf/tables/',
/
